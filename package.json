{
	"name": "3d_cabinet_webapp",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"postinstall": "prisma generate",
		"build": "prisma generate && next build",
		"start": "next start",
		"lint": "biome check .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"generate:grain": "node scripts/generate-grain-texture.mjs",
		"lalamove:ping": "node --env-file=.env.local scripts/lalamove-ping.mjs",
		"easyparcel:ping": "node --env-file=.env.local scripts/easyparcel-ping.mjs",
		"gdex:ping": "node --env-file=.env.local scripts/gdex-ping.mjs",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:migrate": "prisma migrate dev",
		"db:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
		"seed:superadmin": "tsx --conditions=react-server --env-file-if-exists=.env.local prisma/seedSuperadmin.ts",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@mux/mux-node": "^15.1.0",
		"@mux/mux-player-react": "^3.13.3",
		"@mux/upchunk": "^3.5.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@react-three/drei": "^10.7.8",
		"@react-three/fiber": "^9.7.0",
		"@react-three/postprocessing": "^3.1.1",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.8.0",
		"@vercel/speed-insights": "^2.0.0",
		"better-auth": "1.7.5",
		"botid": "^1.5.11",
		"fflate": "^0.8.3",
		"next": "16.3.4",
		"pg": "^8.23.0",
		"posthog-js": "1.430.3",
		"postprocessing": "^6.39.5",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"three": "^0.185.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^20.19.43",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.185.4",
		"dotenv": "^17.4.2",
		"prisma": "7.10.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.20.0"
}
