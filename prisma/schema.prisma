generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Product {
  PLANNER
}

enum Role {
  SUPERADMIN
  ADMIN
  CUSTOMER
}

enum CatalogueStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  DISCARDED
}

/// One design export (a zipped OBJ folder) and the draft `lib/mesh` extracted
/// from it. Immutable — the draft is what the extractor said, never what a
/// human later edited; the human's version is the CatalogueVersion it links to.
model CatalogueImport {
  id            String   @id @default(cuid())
  filename      String
  blobUrl       String
  blobPathname  String
  sizeBytes     Int
  sha256        String   @unique
  sourceVersion String
  draft         Json
  warnings      String[]
  uploadedBy    String
  createdAt     DateTime @default(now())

  versions CatalogueVersion[]
}

/// An immutable-once-published snapshot of one product's catalogue. At most
/// one row per product may have status PUBLISHED — enforced by a partial
/// unique index added by hand in the migration SQL (see migration.sql).
model CatalogueVersion {
  id          String           @id @default(cuid())
  product     Product
  version     Int
  status      CatalogueStatus  @default(DRAFT)
  data        Json
  note        String?
  importId    String?
  import      CatalogueImport? @relation(fields: [importId], references: [id])
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  publishedBy String?
  publishedAt DateTime?

  @@unique([product, version])
  @@index([product, status])
}

enum CabinetCategory {
  BASE_CABINET
  WALL_CABINET
  TALL_CABINET
  DRAWER_BASE
  FRIDGE_HOUSING
  CORNER_BASE_CABINET
  CORNER_WALL_CABINET
}

enum CabinetRoom {
  KITCHEN
  LIVING_ROOM
  BEDROOM
  FOYER
}

enum CabinetDesignStatus {
  PUBLISHED
  ARCHIVED
}

/// One cabinet a customer can place: one uploaded OBJ export, its name, its
/// all-in price and the rooms it is offered in. The planner catalogue's
/// families are rebuilt from these rows on every publish
/// (`lib/catalogue/buildCatalogue.ts`), so a family id is a design id.
model CabinetDesign {
  id           String              @id @default(cuid())
  name         String
  filename     String
  blobUrl      String
  blobPathname String
  sizeBytes    Int
  sha256       String              @unique
  category     CabinetCategory
  /// Every room this cabinet is offered in. Non-empty is enforced by the API.
  rooms        CabinetRoom[]
  widthMm      Int
  heightMm     Int
  depthMm      Int
  priceRm      Float
  /// What one of these weighs, in kg. Null until someone weighs it — a delivery
  /// row pre-filled from an order then leaves weight blank rather than guess.
  weightKg     Float?
  sku          String              @unique
  description  String?
  tags         String?
  finishes     String[]
  status       CabinetDesignStatus @default(PUBLISHED)
  /// What the file holds — shelves, door leaves, drawers, legs — read when the
  /// design is converted. The procedural fallback draws from it. Null means the
  /// file has not been converted yet (or was refused).
  geometry     Json?
  /// The derived render mesh: the drafted geometry, classified by role and
  /// converted to binary at publish time. This is what the planner draws — the
  /// customer sees the model the drafter made, not a box rebuilt from counts.
  ///
  /// Regenerable from `blobPathname` at any time, so it is cache rather than
  /// record: a reader that finds these null falls back to procedural geometry.
  /// The source export stays private; these bytes reach a customer's browser
  /// through `/api/cabinet-mesh/[id]`.
  meshPathname String?
  meshBytes    Int?
  /// Roles and triangle counts, for the review table. The planner does not read
  /// this — the binary is self-describing and carries its own group table.
  meshGroups   Json?
  uploadedBy   String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
}

/// One marketing photo, keyed by the homepage slot it fills (`hero`,
/// `room:kitchen`, `finish:<finishId>`). Unlike CatalogueVersion there is no
/// draft/publish gate — the design's own copy says a photo is live the moment
/// it's dropped, and a wrong photo is trivially reversible by dropping
/// another. Bytes live in Blob (public, since these render on the public
/// homepage); only the URL is stored here, same rule as CatalogueImport.
model SiteImage {
  key          String   @id
  blobUrl      String
  blobPathname String
  filename     String
  sizeBytes    Int
  uploadedBy   String
  updatedAt    DateTime @updatedAt
}

enum TutorialStatus {
  PROCESSING
  READY
  ERRORED
  ARCHIVED
}

/// One DIY tutorial video. The bytes live at Mux, never here and never in
/// Blob: video needs range requests, transcoding and an adaptive bitrate
/// ladder, and the Blob store is private-access-only so it can only be read
/// back through a function that does none of those things.
///
/// `muxUploadId` is the key rather than `muxAssetId` because it is the only id
/// that exists at the moment the row is created — the asset is minted
/// asynchronously once Mux finishes ingesting, and `/status` fills the rest in.
model Tutorial {
  id          String         @id @default(cuid())
  title       String
  /// Optional: the design makes the video and title the only required fields,
  /// so a tutorial can ship before someone writes the blurb.
  description String         @default("")
  /// Validated against CATEGORY_IDS in lib/tutorials.ts, not a Prisma enum:
  /// this vocabulary is data, and an enum makes adding one a migration.
  category    String
  level       String
  sortOrder   Int            @default(0)
  muxUploadId String         @unique
  muxAssetId  String?
  playbackId  String?
  /// Read off the asset once Mux has it, so nobody hand-types "8 min".
  durationSec Int?
  status      TutorialStatus @default(PROCESSING)
  uploadedBy  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, sortOrder])
}

enum DeliveryStatus {
  DRAFT
  QUOTED
  BOOKED
  DRIVER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

/// Where a status write came from. A carrier can tell us the same thing twice
/// through two channels — a webhook and the next poll — and when the two
/// disagree it matters which one said what.
enum DeliveryEventSource {
  ADMIN
  CARRIER_WEBHOOK
  POLL
}

/// One delivery job: finished cabinets leaving the workshop for a customer's
/// site, moved by a logistics partner.
///
/// Free-standing on purpose. There is no order, lead or customer table yet
/// (Phase 3), so the admin types the job in. When lead capture lands it
/// pre-fills this form rather than replacing it — a `leadId` column then, not a
/// different model.
model Delivery {
  id                String         @id @default(cuid())
  /// The job number staff say out loud on the phone. Sequential because
  /// "delivery forty-one" is sayable and a cuid is not.
  number            Int            @unique @default(autoincrement())
  customerName      String
  customerPhone     String
  siteAddress       String
  /// Gate codes, unit numbers, "call on arrival" — the things that decide
  /// whether a lorry gets in, kept out of the address line the carrier geocodes.
  addressNotes      String?
  pickupAddress     String
  /// Where the site actually is. Lalamove prices stop to stop by coordinate and
  /// will not take an address string, so a job without a pin cannot be quoted
  /// by a vehicle partner at all.
  ///
  /// `…GeocodedFor` holds the address the pin was resolved for. Comparing it to
  /// the current address is what keeps an edit that only changed the phone
  /// number from re-geocoding, and what marks an admin-typed override as final.
  siteLat           Float?
  siteLng           Float?
  siteGeocodedFor   String?
  pickupLat         Float?
  pickupLng         Float?
  pickupGeocodedFor String?
  /// What EasyParcel prices against. Lalamove takes coordinates and reads the
  /// address line as a label; a parcel network does the opposite — it wants a
  /// postcode and an ISO 3166-2 subdivision and has no use for a pin. Both are
  /// read out of the same Google reply at save time, so a job carries whichever
  /// half the partner it ends up on needs.
  sitePostcode      String?
  siteCity          String?
  siteState         String?
  pickupPostcode    String?
  pickupCity        String?
  pickupState       String?
  /// The consignment note to print and tape to the box. Distinct from
  /// `trackingUrl`, which is the page the customer watches: a parcel that
  /// leaves the workshop without its AWB affixed does not get collected.
  labelUrl          String?
  /// Line items: `[{ label, qty, widthMm, heightMm, depthMm, weightKg }]`.
  /// Json rather than a table because nothing queries inside it — it is written
  /// whole by the form and read whole by the carrier payload builder.
  items             Json           @default("[]")
  /// Derived from `items` by `lib/logistics/measure.ts`, stored because every
  /// carrier quote wants them and recomputing on each fan-out is pointless.
  totalWeightKg     Float?
  totalVolumeM3     Float?
  scheduledAt       DateTime?
  /// Validated against CARRIER_IDS in lib/logistics/carriers.ts, not a Prisma
  /// enum: same reasoning as `Tutorial.category` — the partner list is data,
  /// and signing a new courier should not be a migration.
  carrierId         String?
  status            DeliveryStatus @default(DRAFT)
  /// The figure the admin saw and confirmed. Kept even after the carrier
  /// invoices differently, because it is what the decision was made on.
  quotedPriceRm     Float?
  /// The carrier's own id for this job. Unique because that uniqueness *is* the
  /// double-book guard: booking spends real money, and a retried request must
  /// not buy a second lorry.
  carrierOrderId    String?        @unique
  trackingUrl       String?
  driverName        String?
  driverPhone       String?
  vehiclePlate      String?
  /// Last known position, as text on the page rather than a map — a map means a
  /// tile provider, a key and bundle weight on a mid-range Android target.
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationAt    DateTime?
  /// Typed on the confirm step. Admin auth is one shared password with no
  /// per-user identity, so this plus DeliveryEvent is the whole audit story
  /// until accounts exist.
  bookedBy          String?
  /// The job this one was cut out of, as the number staff say out loud.
  ///
  /// A bare number rather than a relation: splitting consumes the original —
  /// it never reached a carrier, so there is nothing to keep — and a foreign
  /// key would point at a deleted row. The number is also the only thing any
  /// screen renders of it.
  splitFromNumber   Int?
  /// The unguessable half of the customer's tracking link.
  ///
  /// `number` is sequential and sayable, which is exactly why it cannot be the
  /// key to a public page: this row carries a name, a phone number and a home
  /// address, and `/track/42` would hand the next customer's to anyone who can
  /// count. Separate from `id` as well, so a link forwarded to the wrong
  /// WhatsApp group can be rotated without moving the job.
  publicToken       String         @unique @default(cuid())
  /// The paid order this job delivers, when it came from one. SetNull rather
  /// than cascade: a job already booked with a carrier outlives a removed order.
  orderId           String?
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  events DeliveryEvent[]

  @@index([status, scheduledAt])
  @@index([orderId])
}

/// A customer's checkout: the design they drew, what it was charged, and
/// whether it has been paid. Deliveries are created from a paid order, with
/// their item rows pre-filled from `design` — see `lib/orders`.
model Order {
  id                 String      @id @default(cuid())
  /// Printed as `IC-YYYYMMDD-NNN` (`lib/orders/ref.ts`) and said on the phone.
  number             Int         @unique @default(autoincrement())
  /// The key to the customer's confirmation page, never `number` — same
  /// reasoning as `Delivery.publicToken`.
  publicToken        String      @unique @default(cuid())
  status             OrderStatus @default(AWAITING_PAYMENT)
  customerName       String
  /// E.164, via `lib/logistics/phone.ts`.
  customerPhone      String
  customerEmail      String?
  siteAddress        String
  addressNotes       String?
  roomId             String
  finishId           String
  /// `{ schemaVersion, layout }` — the layout document exactly as ordered.
  design             Json
  /// The published catalogue version it was priced against: the price history.
  catalogueVersionId String
  /// The price breakdown as charged, so the order keeps its figures after the
  /// catalogue moves on.
  breakdown          Json
  cabinetsRm         Float
  deliveryRm         Float
  totalRm            Float
  /// `manual` — bank transfer, marked paid by an admin — until a gateway exists.
  paymentProvider    String      @default("manual")
  paymentRef         String?
  paidAt             DateTime?
  /// Admin auth is one shared password, so this typed name is the record.
  paidBy             String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  deliveries Delivery[]

  /// Null on a pre-cutover or anonymous order. `publicToken` still opens it.
  userId       String?
  user         User?   @relation("OrderCustomer", fields: [userId], references: [id])
  /// Replaces the typed-in `paidBy`: admin auth now knows who it is.
  paidByUserId String?
  paidByUser   User?   @relation("OrderPaidBy", fields: [paidByUserId], references: [id])

  @@index([status, createdAt])
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

/// Every booking, every status change, every webhook payload we accepted.
/// Doubles as the timeline the detail panel renders — the status column is the
/// current state, this is how it got there.
model DeliveryEvent {
  id         String              @id @default(cuid())
  deliveryId String
  delivery   Delivery            @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  at         DateTime            @default(now())
  source     DeliveryEventSource
  /// Null when the event records something other than a transition — a quote
  /// fan-out, an edit, a failed poll.
  status     DeliveryStatus?
  message    String
  /// Who, when we know: the `bookedBy` name for admin actions, null otherwise.
  actor      String?
  /// The carrier's untouched payload. Kept because the first thing anyone asks
  /// about a wrong status is what the carrier actually sent.
  raw        Json?

  @@index([deliveryId, at])
}

/// One logistics partner's OAuth tokens.
///
/// A row rather than an environment variable because the refresh token rotates:
/// EasyParcel hands back a new one on every refresh, and an env var cannot be
/// written from a function. One row per carrier, `carrierId` as the id, so a
/// second OAuth partner needs no migration.
///
/// These are booking credentials. Nothing outside `lib/logistics/tokens.ts`
/// reads this table, and that file is `server-only`.
model CarrierToken {
  carrierId             String   @id
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  /// The admin who clicked through the authorisation. Admin auth is one shared
  /// password, so this name is the whole record of who connected the account.
  connectedBy           String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Customers arrive through Google; staff are invited by a superadmin and sign
/// in with email and password. A row is never hard-deleted — `disabled` is the
/// offboarding switch, because a departed employee's name must stay readable on
/// the orders they marked paid.
model User {
  id                 String    @id
  name               String
  email              String
  emailVerified      Boolean   @default(false)
  image              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  role               Role      @default(CUSTOMER)
  disabled           Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  invitedById        String?
  lastLoginAt        DateTime?
  sessions           Session[]
  accounts           Account[]

  orders     Order[] @relation("OrderCustomer")
  ordersPaid Order[] @relation("OrderPaidBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
