# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "false" opens the admin surface for local work. Ignored in production.
AUTH_ENABLED=true
# Read once by `pnpm seed:superadmin`.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# WhatsApp Cloud API — production only, never set in preview.
# See docs/ops/whatsapp-ezcabinet-setup.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_SALES_NUMBER=
