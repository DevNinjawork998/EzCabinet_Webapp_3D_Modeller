# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor swap and backup files
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Playwright MCP session output: a console log and a page snapshot per run,
# written every time an agent drives the browser. Scratch, never a record.
/.playwright-mcp/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma — generated client, regenerate with `pnpm exec prisma generate`
/src/generated/prisma
next-env.d.ts

graphify-out

# Installed agent skills: vendored third-party content (Leonxlnx/taste-skill,
# no upstream licence shipped) plus a machine-local symlink farm under
# .claude/skills. `.agents/skills/skills.md` is ours and stays tracked.
.agents/skills/*/
.claude/skills/
skills-lock.json

# Per-machine agent permissions. `.claude/settings.json` IS tracked — it is the
# project's shared config. This one is whoever is sitting here, and until now it
# was spared only by a personal ~/.config/git/ignore, which a fresh clone on
# anyone else's machine does not have.
.claude/settings.local.json

# Worktrees for isolated agent work — scratch, never committed.
.claude/worktrees/

# subagent-driven-development scratch — ledger, briefs, review packages
/.superpowers

# A logistics partner's API guide is their confidential document, handed to us
# under their own terms. Read it here, never commit it.
/docs/API Docs/
/City Link API.pdf
